# 대상 보드: ESP32-C3, 플래시 4 MB, 로그는 USB-Serial/JTAG(보드의 USB-C 하나)로 낸다
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# 칩 리비전 하한은 기본(v0.3)을 둔다. v0.0 으로 내린 빌드는 v0.4 칩에서 BLE 시작 직후 ROM 안에서
# Illegal instruction 으로 멈췄다(2026-10-13, HRSIM-7180 실측). 받은 보드는 v0.4 다.

# BLE 는 NimBLE 스택, 주변기기(peripheral) 역할만 쓴다
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# 셀 하나 + 확인용 휴대폰 정도가 붙는다
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
