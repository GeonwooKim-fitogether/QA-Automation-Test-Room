# 이 파일에는 실제 비밀번호나 운영 URL을 넣지 않는다.
APP_ENV=local
APP_BASE_URL=http://localhost:3000

# local Docker PostgreSQL 전용 예시값
POSTGRES_DB=app_local
POSTGRES_USER=app_local
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app_local:local-only-change-me@localhost:5432/app_local

# 애플리케이션이 운영 연결을 실수로 허용하지 않도록 사용하는 힌트다.
# 실제 강제는 배포 권한·네트워크·DB 계정 분리로 한다.
ALLOW_PRODUCTION_DB=false
