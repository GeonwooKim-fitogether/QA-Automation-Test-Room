{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "mcp__Supabase__execute_sql",
      "mcp__github",
      "mcp__supabase-readonly"
    ],
    "ask": [
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__merge_pull_request",
      "mcp__github__push_files"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/report-format-guard.py"
          }
        ]
      },
      {
        "matcher": "Skill|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/retired-guard.py"
          }
        ]
      },
      {
        "matcher": "mcp__Supabase__execute_sql|mcp__Supabase__apply_migration|mcp__github__actions_run_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/sql-write-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/sql-write-guard.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/branch-guard.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/terms-guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
